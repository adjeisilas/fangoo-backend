# Copy to .env and fill in. The app validates these at boot and refuses to
# start if anything required is missing or weak.

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/fangoo

# --- Auth ---
# Generate each one separately, and never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. These must never be committed.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- HTTP ---
PORT=4000
# Comma-separated allow-list of browser origins. Never use "*" — responses
# carry credentials. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# --- Payments (Paystack) ---
# A live deployment must use sk_live_ keys; boot fails if a test key is used
# while NODE_ENV=production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=GHS
# Where Paystack returns the customer after checkout.
PAYSTACK_CALLBACK_URL=http://localhost:3000/orders/payment-callback
