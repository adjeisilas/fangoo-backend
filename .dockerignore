# Keep the build context small and never ship local state into an image.
node_modules
dist
.git
.env
.env.*
!.env.example

# Editor and agent tooling — irrelevant to a build.
.agents
.claude
.cursor
.devin
.windsurf

# Build caches and local artefacts.
*.tsbuildinfo
coverage
*.log

# Generated at build time by `prisma generate`, never copied in.
src/generated

# Not needed to build or run the API. Kept out so editing them does not
# invalidate the build cache and repeat every step after `COPY . .`.
**/*.md
.github
docker-compose.yml
Dockerfile
.dockerignore
