# Copy to .env in this directory before `docker compose up`.
# Compose reads this file automatically; it is never baked into an image.

# --- Database ---
POSTGRES_USER=fangoo
POSTGRES_PASSWORD=
POSTGRES_DB=fangoo

# --- Auth ---
# Generate each one separately, and never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Public URLs ---
# These drive CORS, the Paystack callback, canonical tags and the API base the
# browser calls. Change them together when moving off localhost.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- Payments (Paystack) ---
# A live deployment must use sk_live_ keys; the API refuses to boot with a test
# key while NODE_ENV=production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS

# --- Host ports (optional) ---
WEB_PORT=3000
API_PORT=4000
