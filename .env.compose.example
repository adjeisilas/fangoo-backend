# Copy to .env.compose — NOT .env — then run:
#   docker compose --env-file .env.compose up --build
#
# This repo's .env is the development config and holds real keys; copying over
# it would destroy them. .env.compose is gitignored and never baked into an image.

# --- Database ---
POSTGRES_USER=fangoo
POSTGRES_PASSWORD=
POSTGRES_DB=fangoo

# --- Auth ---
# Generate each one separately, and never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Public URLs ---
# These drive CORS, the Paystack callback, canonical tags and the API base the
# browser calls. They must match WEB_PORT and API_PORT below.
PUBLIC_WEB_URL=http://localhost:3200
PUBLIC_API_URL=http://localhost:4200

# --- Payments (Paystack) ---
# The API runs with NODE_ENV=production and refuses to boot with an sk_test_ key.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS

# --- Host ports ---
# 3200/4200 so this stack can run alongside the dev servers on 3000/4000.
WEB_PORT=3200
API_PORT=4200
